SANITY_PROJECT_ID=mdug7yhz
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# A Sanity API token with at least "Viewer" (read) access to the production
# dataset. Create one at https://www.sanity.io/manage -> your project -> API -> Tokens.
# Keep this secret. It only ever lives on the server, never in the browser.
SANITY_API_TOKEN=

# Any long random string, e.g. generate with: openssl rand -hex 32
# Used to sign the preview session cookie. Keep this secret too.
PREVIEW_COOKIE_SECRET=

SITE_ORIGIN=https://bsd.international

# The Studio URL that should open when someone clicks an overlay in preview.
# Use http://localhost:3333 while testing locally, the hosted Studio URL in production.
PREVIEW_STUDIO_URL=https://bsdinternational-cms.sanity.studio

PORT=4000
